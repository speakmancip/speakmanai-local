# SPEAKMAN.AI Docker Configuration
# Rename this file to .env before running `docker compose up`

# ----------------------------------------------------
# 1. LLM Provider
# Options: gemini | vertexai | anthropic | openai | ollama
# ----------------------------------------------------
LLM_PROVIDER=gemini

# Model tier overrides — agents use abstract tiers (fast / standard / advanced)
# which resolve to these models for the active provider.

# Fast model — lightweight, quick steps
DEFAULT_MODEL=gemini-2.5-flash-lite

# Standard model — general reasoning
STANDARD_MODEL=gemini-2.5-flash

# Advanced model — complex, multi-step reasoning
ADVANCED_MODEL=gemini-2.5-pro

# ----------------------------------------------------
# 2. Provider credentials
# Uncomment and fill in the block for your chosen provider.
# All other blocks should remain commented out.
# ----------------------------------------------------

# --- Gemini (API key) ---
# GEMINI_API_KEY=your-gemini-api-key

# --- Vertex AI (no API key — uses Application Default Credentials) ---
# LLM_PROVIDER=vertexai
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
# For local Docker testing, uncomment the relevant gcloud volume mount in docker-compose.yml
# and set the path to the ADC credentials file inside the container:
# GOOGLE_APPLICATION_CREDENTIALS=/root/.config/gcloud/application_default_credentials.json

# --- Anthropic ---
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- OpenAI ---
# OPENAI_API_KEY=your-openai-api-key

# --- Ollama (local inference) ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_FALLBACK_MODEL=llama3
# Note: 'host.docker.internal' resolves to your host machine from inside Docker

# ----------------------------------------------------
# 3. Database
# ----------------------------------------------------
# MongoDB — spun up automatically with: docker-compose --profile mongo up
MONGO_ATLAS_URI=mongodb://mongodb:27017/
RAW_EVENTS_DB_NAME=speakmanai_db
RAW_EVENTS_COLLECTION=events_raw

# SQLite mode — set to true to skip MongoDB entirely (single-user / lightweight)
# USE_SQLITE=true
# SPEAKMANAI_DB_PATH=/data/speakmanai.db
